{
  "info": {
    "name": "CRUD Master - Microservices API",
    "description": "Collection complète pour tester la plateforme de streaming de films avec architecture microservices",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://192.168.56.10:3000",
      "description": "URL de l'API Gateway"
    },
    {
      "key": "inventory_url", 
      "value": "http://192.168.56.11:8080",
      "description": "URL directe de l'API Inventory"
    },
    {
      "key": "billing_url",
      "value": "http://192.168.56.12:8081", 
      "description": "URL directe de l'API Billing"
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Gateway Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/health",
              "host": ["{{gateway_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Inventory Health Check", 
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_url}}/health",
              "host": ["{{inventory_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Billing Health Check",
          "request": {
            "method": "GET", 
            "header": [],
            "url": {
              "raw": "{{billing_url}}/health",
              "host": ["{{billing_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Movies API (via Gateway)",
      "item": [
        {
          "name": "Get All Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/movies",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies"]
            }
          },
          "response": []
        },
        {
          "name": "Search Movies by Title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/movies?title=inception",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies"],
              "query": [
                {
                  "key": "title",
                  "value": "inception"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Movie by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/movies/1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Create New Movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"description\": \"A mind-bending thriller about dreams within dreams\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/movies",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies"]
            }
          },
          "response": []
        },
        {
          "name": "Create Another Movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Matrix\",\n  \"description\": \"A computer hacker learns about the true nature of reality\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/movies",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies"]
            }
          },
          "response": []
        },
        {
          "name": "Update Movie",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception - Director's Cut\",\n  \"description\": \"A mind-bending thriller about dreams within dreams - Extended version\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/movies/1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Delete Movie by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/movies/1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Delete All Movies",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/movies",
              "host": ["{{gateway_url}}"],
              "path": ["api", "movies"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Billing API (via Gateway)",
      "item": [
        {
          "name": "Process Order - User 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"20\",\n  \"number_of_items\": \"99\",\n  \"total_amount\": \"250\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/billing",
              "host": ["{{gateway_url}}"],
              "path": ["api", "billing"]
            }
          },
          "response": []
        },
        {
          "name": "Process Order - User 2", 
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"22\",\n  \"number_of_items\": \"10\",\n  \"total_amount\": \"50\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/billing",
              "host": ["{{gateway_url}}"],
              "path": ["api", "billing"]
            }
          },
          "response": []
        },
        {
          "name": "Process Order - User 3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"42\",\n  \"number_of_items\": \"3\",\n  \"total_amount\": \"99.99\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/billing",
              "host": ["{{gateway_url}}"],
              "path": ["api", "billing"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Direct API Access (Debug)",
      "item": [
        {
          "name": "Direct - Get All Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_url}}/api/movies",
              "host": ["{{inventory_url}}"],
              "path": ["api", "movies"]
            }
          },
          "response": []
        },
        {
          "name": "Direct - Get All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{billing_url}}/api/orders",
              "host": ["{{billing_url}}"],
              "path": ["api", "orders"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Resilience Tests",
      "item": [
        {
          "name": "Test Order When Billing Down",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ce test doit être exécuté quand l'API Billing est arrêtée",
                  "// Commande: vagrant ssh billing-vm puis sudo pm2 stop billing_app"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"999\",\n  \"number_of_items\": \"1\",\n  \"total_amount\": \"25.50\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/billing",
              "host": ["{{gateway_url}}"],
              "path": ["api", "billing"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gateway Info",
      "item": [
        {
          "name": "Get Gateway Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/info",
              "host": ["{{gateway_url}}"],
              "path": ["api", "info"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ]
}